# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Sistema de Archivos Distribuidos de Alta Disponibilidad (DFSha) - Middleware
# ==============================================================================
# Instrucciones:
# 1. Copie este archivo como '.env' en la carpeta middleware/:
#    cp .env.example .env
# 2. Reemplace los valores de ejemplo con sus credenciales y configuraciones reales.
# 3. NUNCA agregue credenciales reales ni modifique este archivo con secretos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciales y Configuración de AWS / Amazon S3
# ------------------------------------------------------------------------------
# [Obligatoria] Región principal de AWS donde residen los buckets de S3.
# Ejemplo: us-east-1, us-west-2, sa-east-1
AWS_REGION=us-east-1

# [Condicional/Obligatoria para autenticación estática]
# ID de clave de acceso del usuario IAM de AWS.
# (Opcional si la aplicación se ejecuta en una instancia EC2, ECS o EKS con rol IAM adjunto).
AWS_ACCESS_KEY_ID=tu-access-key-id-aqui

# [Condicional/Obligatoria para autenticación estática]
# Clave secreta asociada al usuario IAM de AWS.
AWS_SECRET_ACCESS_KEY=tu-secret-access-key-aqui

# [Opcional] Token de sesión temporal de AWS STS.
# Requerido únicamente si se utilizan credenciales temporales (ej. AWS Academy, Learner Lab o AssumeRole).
# Dejar vacío si se utilizan credenciales de usuario IAM permanente.
AWS_SESSION_TOKEN=

# [Obligatoria] Nombre del bucket principal de Amazon S3 por defecto.
# Se utiliza como destino de almacenamiento para los fragmentos y archivos distribuidos
# a menos que se definan buckets específicos por nodo.
S3_BUCKET_NAME=nombre-del-bucket-s3-principal

# [Opcional] Endpoint personalizado para servicios compatibles con S3 (LocalStack, MinIO, etc.).
# Dejar vacío para utilizar los endpoints globales estándar de AWS S3.
# Ejemplo LocalStack: http://localhost:4566
S3_ENDPOINT_URL=

# [Opcionales] Buckets específicos por nodo para despliegues distribuidos multi-bucket.
# Si no se definen, el sistema utilizará automáticamente S3_BUCKET_NAME para todos los nodos.
# S3_BUCKET_NODE_1=bucket-para-nodo-1
# S3_BUCKET_NODE_2=bucket-para-nodo-2
# S3_BUCKET_NODE_3=bucket-para-nodo-3

# ------------------------------------------------------------------------------
# 2. Configuración de Carga de Archivos (Spring Multipart)
# ------------------------------------------------------------------------------
# Tamaño máximo permitido por archivo individual y por petición HTTP.
MAX-FILE-SIZE=50MB
MAX-REQUEST-SIZE=60MB

# ------------------------------------------------------------------------------
# 3. Seguridad y Tokens JWT
# ------------------------------------------------------------------------------
# [Obligatoria] Clave secreta para la firma y verificación de tokens JWT (mínimo 256 bits).
JWT_KEY=tu-clave-secreta-jwt-de-al-menos-256-bits-para-seguridad

# Tiempo de vida del token en milisegundos (ej. 86400000 = 24 horas).
EXPIRATION_TIME=86400000

# ------------------------------------------------------------------------------
# 4. RabbitMQ (Message-Oriented Middleware)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AUTO_STARTUP=true

# [Opcional] Tamaño máximo por chunk en bytes (por defecto 10485760 = 10MB)
CHUNK_SIZE=10485760

# ------------------------------------------------------------------------------
# 5. Configuración de CORS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

