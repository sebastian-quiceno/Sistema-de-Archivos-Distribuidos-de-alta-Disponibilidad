# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Sistema de Archivos Distribuidos de Alta Disponibilidad (DFSha)
# ==============================================================================
# Instrucciones:
# 1. Copie este archivo como '.env' en la raíz o en la carpeta middleware/:
#    cp .env.example middleware/.env
# 2. Reemplace los valores de ejemplo con sus credenciales y configuraciones reales.
# 3. NUNCA agregue credenciales reales ni modifique este archivo con secretos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciales y Configuración de AWS / Amazon S3
# ------------------------------------------------------------------------------
# [Obligatoria] Región principal de AWS donde residen los buckets de S3.
AWS_REGION=us-east-1

# [Condicional/Obligatoria para autenticación estática]
AWS_ACCESS_KEY_ID=tu-access-key-id-aqui
AWS_SECRET_ACCESS_KEY=tu-secret-access-key-aqui

# [Opcional] Token de sesión temporal de AWS STS (ej. AWS Academy, Learner Lab).
AWS_SESSION_TOKEN=

# [Obligatoria] Nombre del bucket principal de Amazon S3 por defecto.
S3_BUCKET_NAME=nombre-del-bucket-s3-principal

# [Opcional] Endpoint personalizado para servicios compatibles con S3 (LocalStack, MinIO, etc.).
S3_ENDPOINT_URL=

# [Opcionales] Buckets específicos por nodo para despliegues distribuidos multi-bucket.
# S3_BUCKET_NODE_1=bucket-para-nodo-1
# S3_BUCKET_NODE_2=bucket-para-nodo-2
# S3_BUCKET_NODE_3=bucket-para-nodo-3

# ------------------------------------------------------------------------------
# 2. Configuración de Carga de Archivos (Spring Multipart)
# ------------------------------------------------------------------------------
MAX-FILE-SIZE=50MB
MAX-REQUEST-SIZE=60MB

# ------------------------------------------------------------------------------
# 3. Seguridad y Tokens JWT
# ------------------------------------------------------------------------------
JWT_KEY=tu-clave-secreta-jwt-de-al-menos-256-bits-para-seguridad
EXPIRATION_TIME=86400000

# ------------------------------------------------------------------------------
# 4. RabbitMQ
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AUTO_STARTUP=false

# ------------------------------------------------------------------------------
# 5. Configuración de CORS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

