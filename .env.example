# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Sistema de Archivos Distribuidos de Alta Disponibilidad (DFSha)
# ==============================================================================
# Instrucciones:
# 1. Copie este archivo como '.env' en la raíz del proyecto:
#    cp .env.example .env
# 2. Reemplace los valores de ejemplo con sus credenciales y configuraciones reales.
# 3. NUNCA agregue credenciales reales ni modifique este archivo con secretos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL - metadata_DB)
# ------------------------------------------------------------------------------
# [Obligatoria] Nombre del host del servicio de base de datos dentro de Docker.
DB_HOST=database
# [Obligatoria] Puerto expuesto para PostgreSQL.
DB_PORT=5432
# [Obligatoria] Nombre de la base de datos de metadatos.
DB_NAME=metadata_database
# [Obligatoria] Usuario administrador de la base de datos.
DB_USER=middleware_admin
# [Obligatoria] Contraseña del usuario de la base de datos.
DB_PASSWORD=middlewarepassword

# ------------------------------------------------------------------------------
# 2. RabbitMQ (Message-Oriented Middleware - MOM)
# ------------------------------------------------------------------------------
# [Obligatoria] Host del broker RabbitMQ dentro de la red Docker.
RABBITMQ_HOST=rabbitmq
# [Obligatoria] Puerto AMQP estándar para comunicación entre servicios.
RABBITMQ_PORT=5672
# [Obligatoria] Puerto del panel de gestión web de RabbitMQ.
RABBITMQ_MANAGEMENT_PORT=15672
# [Obligatoria] Usuario por defecto de RabbitMQ.
RABBITMQ_USER=guest
# [Obligatoria] Contraseña por defecto de RabbitMQ.
RABBITMQ_PASSWORD=guest
# [Opcional] Activar listeners automáticamente al iniciar el Backend (true/false).
RABBITMQ_AUTO_STARTUP=true

# ------------------------------------------------------------------------------
# 3. Backend (Middleware - Spring Boot)
# ------------------------------------------------------------------------------
# [Obligatoria] Puerto público expuesto para la API del Backend.
BACKEND_PORT=8080
# [Obligatoria] Perfil de ejecución de Spring Boot (prod para Docker con PostgreSQL).
SPRING_PROFILES_ACTIVE=prod
# [Obligatoria] Clave secreta para firma de tokens JWT (mínimo 256 bits).
JWT_KEY=sdan-dfs-ha-super-secret-jwt-key-2026-distributed-file-system-security
# [Obligatoria] Tiempo de expiración del token JWT en milisegundos (86400000 = 24h).
EXPIRATION_TIME=86400000
# [Opcional] Tamaño máximo permitido para archivos individuales cargados.
MAX_FILE_SIZE=500MB
# [Opcional] Tamaño máximo permitido para la petición HTTP de carga.
MAX_REQUEST_SIZE=500MB
# [Opcional] Tamaño en bytes de cada chunk o fragmento distribuido (10485760 = 10MB).
CHUNK_SIZE=10485760
# [Obligatoria] Orígenes permitidos por CORS (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ------------------------------------------------------------------------------
# 4. Frontend (ClientFrontEnd - React + Vite + Nginx)
# ------------------------------------------------------------------------------
# [Obligatoria] Puerto expuesto en el host para acceder a la aplicación web.
FRONTEND_PORT=5173
# [Obligatoria] URL pública del Backend accesible desde el NAVEGADOR del usuario.
# NOTA: No use nombres internos de Docker como 'http://backend:8080/api' aquí,
# ya que el navegador del usuario se ejecuta en el host externo.
VITE_API_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# 5. Amazon S3 / Almacenamiento en la Nube
# ------------------------------------------------------------------------------
# [Obligatoria] Región de AWS donde residen los buckets de S3.
AWS_REGION=us-east-1
# [Condicional] ID de clave de acceso IAM de AWS.
AWS_ACCESS_KEY_ID=tu-access-key-id-aqui
# [Condicional] Clave secreta IAM de AWS.
AWS_SECRET_ACCESS_KEY=tu-secret-access-key-aqui
# [Opcional] Token de sesión temporal para credenciales STS (ej. AWS Academy).
AWS_SESSION_TOKEN=
# [Obligatoria] Nombre del bucket principal de Amazon S3 por defecto.
S3_BUCKET_NAME=nodo-a
# [Opcional] Endpoint personalizado para S3 (ej. LocalStack http://localhost:4566).
S3_ENDPOINT_URL=
